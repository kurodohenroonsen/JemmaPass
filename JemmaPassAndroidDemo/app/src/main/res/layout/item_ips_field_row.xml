<?xml version="1.0" encoding="utf-8"?>
<!--
    item_ips_field_row.xml — single row in the IPS field list of a stub
    pillar. Shows field name + FHIR cardinality + type + description.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ips_field_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/jemma_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="code" />

        <TextView
            android:id="@+id/ips_field_cardinality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/jemma_text_muted"
            android:textSize="10sp"
            tools:text="1..1" />

        <TextView
            android:id="@+id/ips_field_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/jemma_accent"
            android:textSize="10sp"
            tools:text="CodeableConcept" />
    </LinearLayout>

    <TextView
        android:id="@+id/ips_field_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/jemma_text_muted"
        android:textSize="11sp"
        tools:text="Identification de la condition, problème ou diagnostic." />

</LinearLayout>
