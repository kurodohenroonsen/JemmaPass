<?xml version="1.0" encoding="utf-8"?>
<!--
  item_contact_row.xml — Row layout pour ContactsAdapter.

  Structure :
    📞  [Nom du contact]                      [emoji optionnel ›]
        [Relation · Téléphone]
        [Email · Adresse  (line3, gone si vide)]
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="📞"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_row_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Misako Nakamura" />

            <TextView
                android:id="@+id/contact_row_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                tools:text="Conjoint(e) · +32 475 12 34 56" />

            <TextView
                android:id="@+id/contact_row_line3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="misako@example.com · 75 Avenue Louise, Bruxelles" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
