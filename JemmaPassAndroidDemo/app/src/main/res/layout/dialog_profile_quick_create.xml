<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_profile_quick_create.xml — minimal "create profile" dialog.
    Only 2 fields : name + DDN (date de naissance / birth date).
    Validation rule : name non-empty, DDN parseable as YYYY-MM-DD.
    On save : creates the FHIR Patient resource with given/family/birthDate
    only, returns to profiles list with this profile activated.
    User can then complete via the pillar tiles at their own pace.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/jemma_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/jemma_text_muted"
        android:alpha="0.4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/profile_quick_dialog_title"
        android:textColor="@color/jemma_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/profile_quick_dialog_subtitle"
        android:textColor="@color/jemma_text_muted"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/JemmaTextInputLayout"
        android:layout_marginTop="16dp"
        android:hint="@string/profile_quick_field_name">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/profile_quick_field_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/JemmaTextInputLayout"
        android:hint="@string/profile_quick_field_birthdate"
        app:endIconMode="custom"
        app:endIconDrawable="@android:drawable/ic_menu_my_calendar">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/profile_quick_field_birthdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            tools:text="1978-04-12" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/JemmaIpsHint"
        android:layout_marginTop="6dp"
        android:text="@string/profile_quick_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_quick_btn_cancel"
            style="@style/JemmaTextButton"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_quick_btn_create"
            style="@style/JemmaPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="@string/profile_quick_btn_create" />
    </LinearLayout>

</LinearLayout>
