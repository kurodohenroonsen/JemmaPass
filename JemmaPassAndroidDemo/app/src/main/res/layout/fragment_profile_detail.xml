                <LinearLayout
                    android:id="@+id/profile_detail_pregnancy_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ─── FUNCTIONAL STATUS (FHIR-native pillar) ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_functional_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
