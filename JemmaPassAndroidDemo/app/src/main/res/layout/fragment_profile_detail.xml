                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="👤  Haru Nakamura" />

            <TextView
                android:id="@+id/profile_detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/jemma_text_secondary"
                android:textSize="14sp"
                tools:text="📅 1956-02-05 · 🩸 A+" />

            <!-- ─── ALERT BANNER (red if major) ─── -->
