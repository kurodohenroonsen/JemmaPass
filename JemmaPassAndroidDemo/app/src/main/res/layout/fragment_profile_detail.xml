                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="📜 PAST ILLNESSES (2)" />

                <LinearLayout
                    android:id="@+id/profile_detail_past_problems_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ─── PREGNANCY HISTORY (FHIR-native pillar) ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_pregnancy_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_detail_pregnancy_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
