                android:id="@+id/profile_detail_alert_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/jemma_alert_red_bg"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="⚠ 1 interaction MAJEURE détectée"
                tools:visibility="visible" />

            <!-- ─── SAFETY CHECK STATUS (amber : checks not run / incomplete — UC-SAFE-UI) ─── -->
            <TextView
                android:id="@+id/profile_detail_safety_status_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:background="@color/jemma_warning"
                android:padding="12dp"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="@string/profile_detail_safety_not_checked"
                tools:visibility="visible" />

            <!-- ─── ALLERGIES ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_allergies_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_detail_allergies_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="🩹 ALLERGIES (5)" />

                <LinearLayout
                    android:id="@+id/profile_detail_allergies_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ─── MEDICATIONS ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_medications_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_detail_medications_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="💊 MÉDICAMENTS (6)" />

                <LinearLayout
                    android:id="@+id/profile_detail_medications_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ─── CONDITIONS ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_conditions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_detail_conditions_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="🩺 CONDITIONS (1)" />

                <LinearLayout
                    android:id="@+id/profile_detail_conditions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ─── IMMUNIZATIONS (FHIR-native pillar) ─── -->
            <LinearLayout
                android:id="@+id/profile_detail_immunizations_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_detail_immunizations_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="💉 IMMUNIZATIONS (4)" />

                <LinearLayout
                    android:id="@+id/profile_detail_immunizations_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

