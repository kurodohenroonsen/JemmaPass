<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_allergies.xml — IPS AllergyIntolerance resource list (debug à mort).

    Top : RecyclerView of allergies. The user can add a new allergy via :
      🅰 Text   → opens AllergyEditDialog with autocomplete on FTS5 KB
      🎙 Voice  → records audio → Gemma transcribe → Gemma classifier → SNOMED suggestion
      📸 Image  → DocumentScanner → ML Kit OCR → Gemma multimodal → SNOMED extraction

    All 3 paths go through the AllergyExtractPipeline and the DebugConsoleView
    inside AllergyEditDialog shows every step (timing + tokens + KB hit).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jemma_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jemma_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/allergies_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/allergies_title"
            app:subtitle="@string/allergies_subtitle"
            app:titleTextColor="@color/jemma_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/allergies_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="220dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_allergy_row" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/allergies_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/allergies_empty"
            android:textColor="@color/jemma_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 3-FAB stack at bottom-end : Text / Voice / Image -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/allergies_fab_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/allergies_add_image"
            app:backgroundTint="@color/jemma_accent"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_menu_camera"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/allergies_fab_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/allergies_add_voice"
            app:backgroundTint="@color/jemma_accent"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_btn_speak_now"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/allergies_fab_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/allergies_add_text"
            app:backgroundTint="@color/jemma_primary"
            app:icon="@android:drawable/ic_input_add" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
