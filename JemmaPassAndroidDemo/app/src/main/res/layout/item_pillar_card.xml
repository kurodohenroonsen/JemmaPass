<?xml version="1.0" encoding="utf-8"?>
<!--
    item_pillar_card.xml — used for ACTIVE pillars (Perso/Contacts/Allergies/Médocs).
    For STUB pillars (Conditions/Immun/Procedures/Devices), see item_pillar_stub_card.xml.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pillar_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/jemma_card_active"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/jemma_primary_25"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header : emoji + IPS resource type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillar_card_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                tools:text="💊" />

            <TextView
                android:id="@+id/pillar_card_ips_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/jemma_text_muted"
                android:textSize="9sp"
                tools:text="MedicationStatement" />

        </LinearLayout>

        <TextView
            android:id="@+id/pillar_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/jemma_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Médicaments" />

        <!-- Count badge + last updated -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillar_card_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_count"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/jemma_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="6 entrées" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="@color/jemma_text_muted" />

            <TextView
                android:id="@+id/pillar_card_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_text_muted"
                android:textSize="10sp"
                tools:text="il y a 2j" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
