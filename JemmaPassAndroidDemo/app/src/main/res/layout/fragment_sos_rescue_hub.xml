<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_sos_rescue_hub.xml — landing tab "🚨 SOS/Rescue".

    Mostly empty by design : the real interaction is the
    ModeSelectionBottomSheet that auto-opens at onViewCreated. This
    layout's sole responsibility is to provide a "choose mode again"
    fallback button when the user dismisses the sheet without picking.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="32dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🚨"
        android:textSize="64sp"
        app:layout_constraintBottom_toTopOf="@+id/sos_rescue_hub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/sos_rescue_hub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/sos_rescue_hub_title"
        android:textColor="#34D399"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/sos_rescue_hub_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sos_rescue_hub_title" />

    <TextView
        android:id="@+id/sos_rescue_hub_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/sos_rescue_hub_subtitle"
        android:textColor="#CBD5E1"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/sos_rescue_hub_open_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sos_rescue_hub_title" />

    <Button
        android:id="@+id/sos_rescue_hub_open_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/sos_rescue_hub_open_button"
        android:textColor="#34D399"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sos_rescue_hub_subtitle"
        app:strokeColor="#34D399" />

</androidx.constraintlayout.widget.ConstraintLayout>
