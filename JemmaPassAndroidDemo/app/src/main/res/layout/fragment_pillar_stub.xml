<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_pillar_stub.xml — generic info-only screen for Conditions,
    Immunizations, Procedures, Devices. The Fragment receives a `pillarKey`
    nav arg and populates the title + IPS resource type + field list via
    a RecyclerView (item_ips_field_row.xml). Shows the lock chip + a CTA
    "See production app" linking to jemmapass.net.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jemma_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jemma_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/stub_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/stub_title_default"
            app:titleTextColor="@color/jemma_primary"
            tools:title="Conditions" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hero card : emoji + IPS type + lock -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/jemma_card_stub"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/jemma_text_muted"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/stub_hero_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:textSize="48sp"
                            tools:text="🩺" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_locked"
                            android:drawableStart="@android:drawable/ic_lock_lock"
                            android:drawablePadding="4dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/stub_lock_chip"
                            android:textColor="@color/jemma_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/stub_hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/jemma_text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Conditions" />

                    <TextView
                        android:id="@+id/stub_hero_ips_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/jemma_primary"
                        android:textSize="11sp"
                        tools:text="FHIR R4 · Condition" />

                    <TextView
                        android:id="@+id/stub_hero_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/jemma_text"
                        android:textSize="13sp"
                        tools:text="Conditions chroniques actives ou passées (diabète, hypertension, asthme, etc.). Codifiées en SNOMED CT et ICD-10." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- IPS field list section -->
            <TextView
                style="@style/JemmaSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/stub_section_fields" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stub_fields_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ips_field_row" />

            <!-- KB code system links -->
            <TextView
                style="@style/JemmaSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/stub_section_kb_links" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/stub_kb_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp">

                <com.google.android.material.chip.Chip
                    style="@style/JemmaKbChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SNOMED CT"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    style="@style/JemmaKbChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ICD-10" />

            </com.google.android.material.chip.ChipGroup>

            <!-- CTA — production app -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/stub_btn_production"
                style="@style/JemmaTextButton"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:text="@string/stub_btn_production" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
