<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_sheet_add_with_assistant.xml — Lot 14.3 (PHASE 14)

    Bottom sheet déclenché par le FAB + sur les écrans listes
    (Médicaments / Allergies / Contacts / Conditions / piliers stubs).

    Structure :
      ┌──────────────────────────────────────────────────┐
      │              ─── drag handle ───                 │
      │                                                  │
      │    Ajouter un médicament (titre contextuel)      │
      │                                                  │
      │    🤖 ASSISTANT JEMMA                            │
      │    ┌──────────────────────────────────────┐      │
      │    │ 📸  Scanner un document          ▸  │      │
      │    │     Ordonnance, carnet vaccinal…     │      │
      │    ├──────────────────────────────────────┤      │
      │    │ 📷  Live-scan boîte ou plaquette ▸  │      │
      │    │     Caméra continue, temps réel      │      │
      │    ├──────────────────────────────────────┤      │
      │    │ 🎤  Dicter à voix haute          ▸  │      │
      │    │     Parle naturellement              │      │
      │    ├──────────────────────────────────────┤      │
      │    │ 📋  Coller ou écrire du texte    ▸  │      │
      │    │     Depuis un mail, un PDF…          │      │
      │    └──────────────────────────────────────┘      │
      │                                                  │
      │    ─────────────  ou  ─────────────              │
      │                                                  │
      │    ✏️  Saisir manuellement              ▸       │
      │                                                  │
      └──────────────────────────────────────────────────┘

    Accessibilité TalkBack :
    - Le titre porte `accessibilityHeading=true` → annoncé comme heading
    - Le label "🤖 Assistant Jemma" a un contentDescription enrichi
    - Chaque mode est un bloc focusable avec contentDescription complet
    - Touch target ≥ 48dp partout
    - Les emojis décoratifs ont importantForAccessibility="no" sur leur
      TextView, le sens passe par le contentDescription du parent
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/jemma_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp">

        <!-- Drag handle décoratif. -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#3A4D63"
            android:importantForAccessibility="no" />

        <!-- Titre contextuel (set dynamiquement par le fragment selon le pilier).
             tools:text affiche un exemple en preview Android Studio. -->
        <TextView
            android:id="@+id/assistant_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:textColor="@color/jemma_text"
            android:textSize="20sp"
            tools:text="@string/assistant_sheet_title_medications" />

        <!-- Section header : 🤖 Assistant Jemma -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/jemmapass_icon"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/assistant_section_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:contentDescription="@string/assistant_section_header_cd"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="@string/assistant_section_header"
                android:textAllCaps="true"
                android:textColor="@color/jemma_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ─── Mode 1 : Scanner un document ─── -->
        <LinearLayout
            android:id="@+id/assistant_mode_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_assistant_mode_row"
            android:clickable="true"
            android:contentDescription="@string/assistant_mode_photo_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/assistant_mode_photo_emoji"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="💊"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/assistant_mode_photo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/assistant_mode_photo"
                    android:textColor="@color/jemma_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/assistant_mode_photo_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/assistant_mode_photo_sub"
                    android:textColor="@color/jemma_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 🆕 Lot 14.5c11/c14 — Badge "démo" : signale le mode actif.
                 Kotlin le rend visible quand pillar=MEDICATIONS. -->
            <TextView
                android:id="@+id/assistant_mode_photo_demo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_assistant_demo_badge"
                android:contentDescription="@string/assistant_mode_demo_badge_cd"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/assistant_mode_demo_badge"
                android:textAllCaps="true"
                android:textColor="@color/jemma_accent"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/assistant_mode_photo_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="▸"
                android:textColor="@color/jemma_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- ─── Mode 2 : Scanner un document (était Live-scan) ─── -->
        <LinearLayout
            android:id="@+id/assistant_mode_livescan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_assistant_mode_row"
            android:clickable="true"
            android:contentDescription="@string/assistant_mode_livescan_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="📸"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/assistant_mode_livescan"
                    android:textColor="@color/jemma_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/assistant_mode_livescan_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/assistant_mode_livescan_sub"
                    android:textColor="@color/jemma_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="🔒"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ─── Mode 3 : Voix ─── -->
        <LinearLayout
            android:id="@+id/assistant_mode_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_assistant_mode_row"
            android:clickable="true"
            android:contentDescription="@string/assistant_mode_voice_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="🎤"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/assistant_mode_voice"
                    android:textColor="@color/jemma_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/assistant_mode_voice_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/assistant_mode_voice_sub"
                    android:textColor="@color/jemma_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 🆕 Lot 14.5c14 — Badge "démo" pour mode_voice (gone par défaut,
                 rendu visible par le Kotlin quand pillar=ALLERGIES). -->
            <TextView
                android:id="@+id/assistant_mode_voice_demo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_assistant_demo_badge"
                android:contentDescription="@string/assistant_mode_demo_badge_cd"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/assistant_mode_demo_badge"
                android:textAllCaps="true"
                android:textColor="@color/jemma_accent"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/assistant_mode_voice_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="🔒"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ─── Mode 4 : Texte (paste/type) ─── -->
        <LinearLayout
            android:id="@+id/assistant_mode_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_assistant_mode_row"
            android:clickable="true"
            android:contentDescription="@string/assistant_mode_text_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="📋"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/assistant_mode_text"
                    android:textColor="@color/jemma_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="@string/assistant_mode_text_sub"
                    android:textColor="@color/jemma_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="🔒"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ─── Divider — ou — ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2D3A4D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/assistant_sheet_divider_or"
                android:textColor="@color/jemma_text_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2D3A4D" />
        </LinearLayout>

        <!-- ─── Manual fallback ─── -->
        <LinearLayout
            android:id="@+id/assistant_mode_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/assistant_sheet_manual_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="✏️"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/assistant_sheet_manual"
                android:textColor="@color/jemma_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="▸"
                android:textColor="@color/jemma_text_muted"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
