<?xml version="1.0" encoding="utf-8"?>
<!--
    view_chat_msg_bg_action.xml — Lot 14.5c30

    Material 3-style "chip" rendered inline in the chat list, centered, used
    to surface every @Tool invocation Gemma performs. Three visual states :

      RUNNING   ⏳  Recherche SNOMED…
      DONE      ✅  SNOMED 91936005           187ms
      FAILED    ❌  Recherche échouée

    Layout :
      ┌──────────────────────────────────────────────────────┐
      │ [emoji] [label · value]                  [latency]   │
      │         [detail expandable on tap]                   │
      └──────────────────────────────────────────────────────┘

    The chip is tap-to-expand : tapping shows `detail` (e.g. full SNOMED
    candidate list). Otherwise compact.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bg_action_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_bubble_jemma"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:minHeight="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top row: emoji + label + value + latency -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bg_action_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:text="💊" />

            <TextView
                android:id="@+id/bg_action_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/jemma_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Substance" />

            <TextView
                android:id="@+id/bg_action_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4sp"
                android:layout_marginEnd="4sp"
                android:textColor="@color/jemma_text"
                android:textSize="13sp"
                android:text="·" />

            <TextView
                android:id="@+id/bg_action_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/jemma_text"
                android:textSize="13sp"
                tools:text="Pénicilline" />

            <TextView
                android:id="@+id/bg_action_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/jemma_text_muted"
                android:textSize="11sp"
                tools:text="187ms" />
        </LinearLayout>

        <!-- Optional detail row (expandable). Hidden by default. -->
        <TextView
            android:id="@+id/bg_action_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/jemma_text_muted"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="91936005 · Allergie à la pénicilline\n764146007 · penicillins"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
