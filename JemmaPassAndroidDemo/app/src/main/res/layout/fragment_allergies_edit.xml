<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_allergies_edit.xml — JEMMA Pass · v2.6.0 · L_HERO_BAR

  🆕 v2.6.0 L_HERO_BAR — Toolbar + hero séparés fusionnés en UNE seule
  bande horizontale en haut. Plus de doublon de titre.

  Structure :
    [← back] [🩹] [Allergies / 1 allergie] [...]

  Le back-arrow est un ImageButton à gauche avec ripple, le bloc emoji+
  titre+count est cliquable-not (juste affichage). Pas de MaterialToolbar
  → pas de gestion automatique du title qui pollue.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══ Bande hero unifiée (back + emoji + titre + count) ═══ -->
        <LinearLayout
            android:id="@+id/allergies_hero_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Back arrow — ImageButton, ripple selectableItemBackgroundBorderless -->
            <ImageButton
                android:id="@+id/allergies_toolbar_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_navigate_back_icon"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="@android:color/white" />

            <!-- Emoji domain icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:text="🩹"
                android:textSize="32sp" />

            <!-- Titre + count (column) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/allergies_edit_hero_title"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/allergies_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    tools:text="1 allergie" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Liste + état vide ═══ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allergies_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="160dp"
            tools:listitem="@layout/item_allergy_row" />

        <LinearLayout
            android:id="@+id/allergies_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="48sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/allergies_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:gravity="center"
                android:text="@string/allergies_empty_default" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/allergies_fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="76dp"
        android:contentDescription="@string/allergies_fab_add_desc"
        android:src="@drawable/ic_plus_24"
        app:backgroundTint="#3B82F6"
        app:tint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
