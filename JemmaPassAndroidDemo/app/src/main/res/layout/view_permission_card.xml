<?xml version="1.0" encoding="utf-8"?>
<!--
    view_permission_card.xml — single permission card included 5 times in
    fragment_permissions.xml (camera, mic, bluetooth, location, notifications).

    The Fragment populates the emoji + title + description + status pill
    based on the card's id. Tap on the card body fires the per-permission
    request flow. Tap on a card already in DENIED_PERMANENT state opens the
    system Settings page for the app so the user can flip the toggle.

    Status pill colors (managed by Fragment with setBackgroundResource) :
       PENDING            → bg_pill_locked  + text "À faire"
       GRANTED            → bg_pill_count   + text "✓ Accordé"   (primary green)
       DENIED             → bg_pill_locked  + text "✗ Refusé"    (text muted)
       DENIED_PERMANENT   → bg_warning_chip + text "⚙ Réglages"  (severity_high)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/jemma_card_active"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/jemma_primary_25"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header row : emoji + title + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/perm_card_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textSize="22sp"
                tools:text="📷" />

            <TextView
                android:id="@+id/perm_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/jemma_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Caméra" />

            <TextView
                android:id="@+id/perm_card_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_locked"
                android:fontFamily="monospace"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/jemma_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="À faire" />

        </LinearLayout>

        <!-- Description (why we need this perm) -->
        <TextView
            android:id="@+id/perm_card_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/jemma_text_muted"
            android:textSize="12sp"
            tools:text="Scanner les boîtes de médicaments, blisters et ordonnances pour identifier la molécule via Gemma 4 multimodal." />

        <!-- Underlying Android permissions (educational, mono small text).
             E.g. for Bluetooth : "android.permission.BLUETOOTH_SCAN, _ADVERTISE, _CONNECT" -->
        <TextView
            android:id="@+id/perm_card_underlying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/jemma_primary"
            android:textSize="9sp"
            tools:text="android.permission.CAMERA" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
