<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_medication_edit.xml — MedicationEditDialog.
    Manual edit form for a MedicationStatement. The scan path uses a separate
    layout (dialog_med_scan.xml) which has its own debug pipeline UI.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/jemma_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/medication_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medication_dialog_title_new"
            android:textColor="@color/jemma_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="@string/medication_dialog_ips_type"
            android:textColor="@color/jemma_text_muted"
            android:textSize="10sp" />

        <!-- Drug name with autocomplete on KB ATC + voice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/JemmaTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="@string/medication_field_name">
                <AutoCompleteTextView
                    android:id="@+id/medication_field_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="2"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/medication_field_name_voice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_voice_btn"
                android:contentDescription="@string/voice_input_cd"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/jemma_primary" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/JemmaTextInputLayout"
            android:hint="@string/medication_field_atc"
            app:startIconDrawable="@android:drawable/ic_menu_info_details">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/medication_field_atc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:focusable="false"
                android:textColor="@color/jemma_primary"
                tools:text="J01CA04" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dose + Unit row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/JemmaTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="@string/medication_field_dose">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medication_field_dose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/JemmaTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="@string/medication_field_unit"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/medication_field_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:text="mg" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Frequency -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/JemmaTextInputLayout"
            android:hint="@string/medication_field_frequency"
            app:helperText="@string/medication_field_frequency_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/medication_field_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Route -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/JemmaTextInputLayout"
            android:hint="@string/medication_field_route"
            app:endIconMode="dropdown_menu">
            <AutoCompleteTextView
                android:id="@+id/medication_field_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:text="Oral" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Active flag -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/medication_field_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/medication_field_active"
            android:textColor="@color/jemma_text" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/medication_btn_delete"
                style="@style/JemmaTextButton"
                android:textColor="@color/jemma_danger"
                android:text="@string/btn_delete"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/medication_btn_cancel"
                style="@style/JemmaTextButton"
                android:text="@string/btn_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/medication_btn_save"
                style="@style/JemmaPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
