<?xml version="1.0" encoding="utf-8"?>
<!--
    item_profile_summary.xml — v2.2.16.7

    Card layout for one profile in the Profiles list (RecyclerView).
    Used by ProfileListAdapter.

    Layout :
        ┌──────────────────────────────────────────────────────┐
        │ 👤 Haru Nakamura                             ⭐  🗑 │
        │ 1956-02-05 · A+                                       │
        │ 🩹 5 allergies · 💊 6 médicaments                     │
        └──────────────────────────────────────────────────────┘

    The ⭐ TextView is ALWAYS visible : gold when current, gray otherwise.
    Tap ⭐ toggles current. Tap 🗑 opens delete confirm. Tap card body
    opens detail. Long-press card opens action menu.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/jemma_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/jemma_primary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Center column : name / details / counters -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="👤  Haru Nakamura" />

            <TextView
                android:id="@+id/profile_card_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/jemma_text_secondary"
                android:textSize="14sp"
                tools:text="1956-02-05 · A+" />

            <TextView
                android:id="@+id/profile_card_counters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/jemma_text_primary"
                android:textSize="13sp"
                tools:text="🩹 5 allergies · 💊 6 médicaments" />

        </LinearLayout>

        <!-- ⭐ Set/Unset current profile (always visible). -->
        <TextView
            android:id="@+id/profile_card_star"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Set as current profile"
            android:focusable="true"
            android:gravity="center"
            android:textSize="26sp"
            tools:text="⭐" />

        <!-- 🗑 Delete profile (always visible). -->
        <TextView
            android:id="@+id/profile_card_delete"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Delete profile"
            android:focusable="true"
            android:gravity="center"
            android:textSize="26sp"
            tools:text="🗑" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
