<?xml version="1.0" encoding="utf-8"?>
<!--
    view_demo_not_ready_banner.xml — orange warning strip shown above the
    profile list when the Settings preflight checklist has at least one ❌.
    Tap → navigate to dest_settings to fix it.

    Driven by SettingsPreflightState (LiveData) :
       - allReady=true  → Fragment hides this banner
       - allReady=false → Fragment shows + populates `banner_text` with the
                          summary "X of Y items missing"
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/demo_banner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/jemma_warning"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="@android:color/white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profiles_banner_title"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            tools:text="2 sur 5 éléments manquants" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profiles_banner_action"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        android:src="@android:drawable/ic_media_play"
        app:tint="@android:color/white" />

</LinearLayout>
