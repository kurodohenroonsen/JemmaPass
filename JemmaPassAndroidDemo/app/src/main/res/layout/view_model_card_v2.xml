<?xml version="1.0" encoding="utf-8"?>
<!--
    view_model_card_v2.xml — REVAMPED model card with expand-on-tap behavior.

    Replaces view_model_card.xml (livraison_layouts_1.0). Two-state UI :
      • COLLAPSED : header row only (emoji + name + capabilities + status pill + size)
      • EXPANDED  : header row + download progress + tech details + action button row
                    (Activate / Delete / Re-download / Pause / Resume)

    Used 3 times in fragment_settings.xml :
      • settings_model_e2b   →  Gemma 4 E2B  (2.4 GB · text + vision + audio)
      • settings_model_e4b   →  Gemma 4 E4B  (3.4 GB · text + vision + audio)
      • settings_model_270m  →  Gemma 3 270M (290 MB · intent classifier only)

    The Fragment toggles `model_card_expanded_section` visibility on header tap.

    4-state ModelDownloadStatus mapped (inspired by Edge Gallery) :
      NOT_DOWNLOADED  → pill grey  · btn "Télécharger"
      IN_PROGRESS     → pill blue  · btn "Pause"   · progress bar visible
      SUCCEEDED       → pill green · btn "Activer" or "★ ACTIF" if active
      FAILED          → pill red   · btn "Réessayer" + error message
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/model_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/jemma_card_active"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/jemma_primary_25"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Header row : always visible, tap to toggle expand ─── -->
        <LinearLayout
            android:id="@+id/model_card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/model_card_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textSize="22sp"
                tools:text="🧠" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/model_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jemma_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Gemma 4 E4B" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/model_card_capabilities"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/jemma_text_muted"
                        android:textSize="11sp"
                        tools:text="text · vision · audio" />

                    <TextView
                        android:id="@+id/model_card_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/jemma_primary"
                        android:textSize="10sp"
                        tools:text="3.4 GB" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/model_card_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_count"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/jemma_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="★ ACTIF" />

            <ImageView
                android:id="@+id/model_card_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/jemma_text_muted"
                tools:rotation="180" />

        </LinearLayout>

        <!-- ─── Download progress (visible only when IN_PROGRESS) ─── -->
        <LinearLayout
            android:id="@+id/model_card_progress_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/model_card_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progressTint="@color/jemma_primary"
                tools:progress="62" />

            <TextView
                android:id="@+id/model_card_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/jemma_text_muted"
                android:textSize="10sp"
                tools:text="2.1 GB / 3.4 GB · 18 MB/s · ~1 min restantes" />
        </LinearLayout>

        <!-- ─── Expanded section (visible when card is tapped) ─── -->
        <LinearLayout
            android:id="@+id/model_card_expanded_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View style="@style/JemmaDivider"
                  android:layout_marginTop="0dp"
                  android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/model_card_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_text_muted"
                android:textSize="12sp"
                tools:text="Gemma 4 E4B est le modèle multimodal premium de la famille Gemma 4. Idéal pour les téléphones avec ≥ 8 GB RAM. Plus précis que E2B, mais plus lent au prefill (~700 ms vs 400 ms)." />

            <!-- 2x2 stat grid : backend / source / latency / RAM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/JemmaTelemetryLabel"
                        android:text="@string/model_stat_backend" />
                    <TextView
                        android:id="@+id/model_card_backend"
                        style="@style/JemmaTelemetryValue"
                        tools:text="GPU" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/JemmaTelemetryLabel"
                        android:text="@string/model_stat_format" />
                    <TextView
                        android:id="@+id/model_card_format"
                        style="@style/JemmaTelemetryValue"
                        tools:text=".litertlm" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/JemmaTelemetryLabel"
                        android:text="@string/model_stat_prefill" />
                    <TextView
                        android:id="@+id/model_card_prefill"
                        style="@style/JemmaTelemetryValue"
                        tools:text="690 ms" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/JemmaTelemetryLabel"
                        android:text="@string/model_stat_decode" />
                    <TextView
                        android:id="@+id/model_card_decode"
                        style="@style/JemmaTelemetryValue"
                        tools:text="18 tok/s" />
                </LinearLayout>

            </LinearLayout>

            <!-- Source URL (jemmapass.net or huggingface.co) -->
            <TextView
                android:id="@+id/model_card_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/jemma_primary"
                android:textSize="10sp"
                tools:text="https://jemmapass.net/models/gemma-4-E4B-it.litertlm" />

            <!-- ─── Action buttons row ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/model_card_btn_delete"
                    style="@style/JemmaTextButton"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/jemma_danger"
                    android:text="@string/btn_delete"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@color/jemma_danger"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/model_card_btn_secondary"
                    style="@style/JemmaTextButton"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:text="Pause"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/model_card_btn_primary"
                    style="@style/JemmaPrimaryButton"
                    android:layout_width="wrap_content"
                    tools:text="Activer" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
