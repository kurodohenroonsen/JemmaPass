<?xml version="1.0" encoding="utf-8"?>
<!--
    view_export_format_card.xml — single export format card reused 4 times in
    fragment_export_hub.xml. Fragment populates the icon, title, spec, byte
    estimate, and wires the action button.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/jemma_card_active"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/export_card_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="28sp"
            tools:text="📦" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/export_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Pruned _j 1.2" />

            <TextView
                android:id="@+id/export_card_spec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/jemma_primary"
                android:textSize="10sp"
                tools:text="IPS minimal · base85 · 1 QR" />

            <TextView
                android:id="@+id/export_card_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jemma_text_muted"
                android:textSize="11sp"
                tools:text="≈ 2.1 KB" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/jemma_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
