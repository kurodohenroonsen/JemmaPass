<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#475569" />

    <TextView
        android:id="@+id/medication_form_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="💊  Ajouter un médicament" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- ─── Substance (KB drug picker) ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/medication_form_substance_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medication_form_label_substance"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/medication_form_substance_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B82F6"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="10dp"
                            tools:text="B01AA03" />

                        <TextView
                            android:id="@+id/medication_form_substance_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:hint="@string/medication_form_substance_hint"
                            android:textColorHint="#475569"
                            tools:text="Warfarine sodium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#64748B"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Dose value + unit ─────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginEnd="8dp"
                    android:hint="@string/medication_form_label_dose_value"
                    app:boxStrokeColor="#3B82F6"
                    app:hintTextColor="#3B82F6">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/medication_form_dose_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/medication_form_label_dose_unit"
                    app:boxStrokeColor="#3B82F6"
                    app:hintTextColor="#3B82F6">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/medication_form_dose_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ─── Timing ────────────────────────────────── -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/medication_form_label_timing"
                app:boxStrokeColor="#3B82F6"
                app:hintTextColor="#3B82F6"
                app:helperText="@string/medication_form_timing_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medication_form_timing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@android:color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─── Route (toggle 4-way) ──────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/medication_form_label_route"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_route_oral"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medication_form_route_oral"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_route_injection"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medication_form_route_injection"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_route_topical"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medication_form_route_topical"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_route_subcutaneous"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medication_form_route_subcutaneous"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ─── 🆕 v2.6.0k — IPS-FULL : Status ─────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/medication_form_label_status"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/medication_form_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="#1E293B"
                android:padding="12dp">

                <TextView
                    android:id="@+id/medication_form_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:text="@string/medication_form_status_hint"
                    tools:text="✅ En cours" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#64748B"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- ─── 🆕 v2.6.0k — IPS-FULL : Effective date ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/medication_form_label_effective"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/medication_form_effective_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="#1E293B"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="📅"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/medication_form_effective_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:text="@string/medication_form_effective_hint"
                    tools:text="2025-03-15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_effective_clear"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:visibility="gone"
                    android:contentDescription="@string/medication_form_effective_clear_desc"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="#94A3B8"
                    app:iconSize="18dp"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#64748B"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- ─── 🆕 v2.6.0k — IPS-FULL : ReasonCode KB ───── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/medication_form_label_reason_code"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/medication_form_reason_code_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="#1E293B"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="🩺"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/medication_form_reason_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#3B82F6"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="38341003" />

                    <TextView
                        android:id="@+id/medication_form_reason_code_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:text="@string/medication_form_reason_code_hint"
                        tools:text="Hypertension artérielle" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medication_form_reason_code_clear"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:visibility="gone"
                    android:contentDescription="@string/medication_form_reason_code_clear_desc"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="#94A3B8"
                    app:iconSize="18dp"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#64748B"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- ─── Reason (text libre, existant) ────────── -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/medication_form_label_reason"
                app:boxStrokeColor="#3B82F6"
                app:hintTextColor="#3B82F6"
                app:helperText="@string/medication_form_reason_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medication_form_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@android:color/white" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/medication_form_cancel_btn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medication_form_cancel"
            android:textColor="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/medication_form_save_btn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/medication_form_save"
            android:textStyle="bold"
            android:backgroundTint="#3B82F6"
            app:icon="@drawable/ic_check_24"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</LinearLayout>
