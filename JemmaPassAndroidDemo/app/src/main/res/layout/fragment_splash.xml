<?xml version="1.0" encoding="utf-8"?>
<!--
    JemmaAppDemo — fragment_splash.xml
    Shown during Gemma-engine warmup + KB load. Keeps the user busy with the
    mascot animation so the 30-40s cold-init of the .litertlm engine never
    forces them into a black screen. The PhasesProgressView walks through
    "Loading model → Loading KB → Indexing FTS5 → Ready".
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jemma_bg"
    android:padding="32dp">

    <ImageView
        android:id="@+id/splash_mascot"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/jemma_mascot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splash_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.35"
        tools:src="@android:drawable/sym_def_app_icon" />

    <TextView
        android:id="@+id/splash_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/jemma_app_name"
        android:textColor="@color/jemma_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/splash_mascot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/splash_tagline"
        android:textColor="@color/jemma_text_muted"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/splash_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Phases progress : Model / KB / FTS / Ready -->
    <ProgressBar
        android:id="@+id/splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="40dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/jemma_primary"
        app:layout_constraintTop_toBottomOf="@id/splash_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:progress="42" />

    <TextView
        android:id="@+id/splash_phase_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/jemma_text"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/splash_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Chargement du modèle Gemma 4 E4B…" />

    <TextView
        android:id="@+id/splash_phase_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/jemma_text_muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/splash_phase_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2.8 GB / 3.4 GB · 18 MB/s · GPU backend" />

    <TextView
        android:id="@+id/splash_offline_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill_offline"
        android:drawableStart="@android:drawable/ic_lock_lock"
        android:drawablePadding="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/splash_offline_chip"
        android:textColor="@color/jemma_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
