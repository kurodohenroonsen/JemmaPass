<?xml version="1.0" encoding="utf-8"?>
<!--
    item_pillar_stub_card.xml — for the 4 stub pillars (Conditions, Immunizations,
    Procedures, Devices). Shows lock icon + IPS resource type + "Coming in production".
    Tap opens PillarStubFragment with the IPS field list + KB code system links.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pillar_stub_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/jemma_card_stub"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/jemma_text_muted"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillar_stub_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.55"
                android:textSize="28sp"
                tools:text="🩺" />

            <TextView
                android:id="@+id/pillar_stub_ips_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/jemma_text_muted"
                android:textSize="9sp"
                tools:text="Condition" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="@color/jemma_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/pillar_stub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.8"
            android:textColor="@color/jemma_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Conditions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pillar_stub_coming_soon"
            android:textColor="@color/jemma_text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
