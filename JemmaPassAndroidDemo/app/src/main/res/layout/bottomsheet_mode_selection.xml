<?xml version="1.0" encoding="utf-8"?>
<!--
    bottomsheet_mode_selection.xml — modal sheet exposing 2 large
    cards : "🆘 SOS" (victim mode) and "⛑️ Rescue" (rescuer mode).
    Each card is a clickable LinearLayout with the icon + title +
    subtitle stacked.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="@string/mode_select_title"
        android:textColor="#F1F5F9"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ─── 🆘 SOS card ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/mode_card_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_mode_card_sos"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="20dp"
            android:text="🆘"
            android:textSize="48sp"
            tools:ignore="RtlSymmetry"
            xmlns:tools="http://schemas.android.com/tools" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_select_sos_title"
                android:textColor="#FECACA"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mode_select_sos_subtitle"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ─── ⛑️ Rescuer card ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/mode_card_rescuer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mode_card_rescuer"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="20dp"
            android:text="⛑️"
            android:textSize="48sp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_select_rescuer_title"
                android:textColor="#A7F3D0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mode_select_rescuer_subtitle"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
