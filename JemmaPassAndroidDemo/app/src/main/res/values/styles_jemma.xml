<?xml version="1.0" encoding="utf-8"?>
<!--
    styles_jemma.xml — reusable widget styles for JemmaAppDemo. Kept separate
    from the original Edge Gallery themes.xml to avoid conflicts.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Section header — used between groups of fields -->
    <style name="JemmaSectionHeader" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/jemma_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Field label (small, above an input) -->
    <style name="JemmaFieldLabel" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/jemma_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Standard text input wrapper -->
    <style name="JemmaTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="boxStrokeColor">@color/jemma_primary</item>
        <item name="hintTextColor">@color/jemma_primary</item>
    </style>

    <!-- Buttons -->
    <style name="JemmaPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/jemma_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="JemmaTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_primary</item>
    </style>

    <style name="JemmaDangerButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/jemma_danger</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Segmented toggle button (gender, severity) -->
    <style name="JemmaSegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="strokeColor">@color/jemma_primary_25</item>
        <item name="android:textColor">@color/jemma_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Triage action button (radar peer row) -->
    <style name="JemmaTriageActionBtn" parent="android:Widget">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_triage_btn</item>
        <item name="android:padding">7dp</item>
        <item name="tint">@color/jemma_text</item>
    </style>

    <!-- Vital cell label (sex/age/blood/triage) -->
    <style name="JemmaVitalLabel" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="JemmaVitalValue" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Section header for the patient detail sheet (smaller than home) -->
    <style name="JemmaPatientSectionHeader" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- IPS hint footnote -->
    <style name="JemmaIpsHint" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Divider -->
    <style name="JemmaDivider" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@color/jemma_primary_25</item>
    </style>

    <!-- KB chip (Settings stub) -->
    <style name="JemmaKbChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/jemma_card_active</item>
        <item name="android:textColor">@color/jemma_primary</item>
    </style>

    <!-- Telemetry mini-card (SOS broadcast) -->
    <style name="JemmaTelemetryLabel" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="JemmaTelemetryValue" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jemma_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
