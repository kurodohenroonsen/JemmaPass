    <!-- Card descriptions -->
    <string name="permission_camera_desc">Scan medication boxes, blisters and prescriptions to identify the molecule via Gemma 4 multimodal.</string>
    <string name="permission_microphone_desc">Dictate your allergies, medications and contact names. Your voice is transcribed locally by Gemma 4 — never sent to a cloud.</string>
    <string name="permission_bluetooth_desc">Discover and broadcast SOS chunks via the JEMMA mesh during a mass-casualty incident. No internet required.</string>
    <string name="permission_location_desc">Embed your GPS coordinates in your SOS chunks so rescuers can find you on the radar.</string>
    <string name="permission_notifications_desc">Keep the SOS broadcaster alive in the background and alert nearby rescuers.</string>

    <!-- Status pill labels -->
