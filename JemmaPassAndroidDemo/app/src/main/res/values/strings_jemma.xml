    <!-- Privacy + Why -->
    <string name="permissions_privacy_note">JEMMA never uploads your data. These permissions stay on your phone. Mode avion ou rien.</string>
    <string name="permissions_why_link">Why are all of them mandatory ?</string>
    <string name="permissions_why_text">JemmaAppDemo is a real demo, not a faked one. Every feature shown to the jury must work end-to-end :\n\n• The medication-scan pipeline needs the camera.\n• The voice input pipeline needs the microphone.\n• The mesh SOS broadcast needs the 3 Bluetooth permissions + GPS + the foreground-service notification.\n\nIf any of these are denied, the matching demo would fail mid-recording. The hackathon rules require a fully functional submission.</string>

    <!-- Settings rationale (shown in dialog when DENIED_PERMANENT) -->
    <string name="permissions_rationale_title">Open Settings</string>
    <string name="permissions_rationale_message">You\'ve previously denied this permission. Please grant it manually in Android Settings → Apps → JemmaAppDemo → Permissions.</string>
    <string name="permissions_rationale_btn_open">Open Settings</string>
    <string name="permissions_rationale_btn_cancel">Cancel</string>


