    <!-- ═════ Permissions onboarding (Livraison_demo_permissions_1.2.0) ═════ -->

    <!-- Header -->
    <string name="permissions_title">Autorisations requises</string>
    <string name="permissions_intro">JemmaAppDemo fonctionne 100 % sur l\'appareil. Pour cela, elle a besoin de quelques accès Android. Chaque permission ne sert qu\'à la fonctionnalité associée.</string>
    <string name="permissions_mandatory_chip">Toutes obligatoires pour la démo</string>

    <!-- Card titles -->
    <string name="permission_camera_title">Caméra</string>
    <string name="permission_microphone_title">Microphone</string>
    <string name="permission_bluetooth_title">Bluetooth (3 permissions)</string>
    <string name="permission_location_title">Localisation précise</string>
    <string name="permission_notifications_title">Notifications</string>

    <!-- Card descriptions -->
    <string name="permission_camera_desc">Scanner les boîtes de médicaments, blisters et ordonnances pour identifier la molécule via Gemma 4 multimodal.</string>
    <string name="permission_microphone_desc">Dicter vos allergies, médicaments et noms de contacts. Votre voix est transcrite localement par Gemma 4 — jamais envoyée à un cloud.</string>
    <string name="permission_bluetooth_desc">Découvrir et diffuser les chunks SOS via le mesh JEMMA en cas d\'incident grave. Aucune connexion internet requise.</string>
    <string name="permission_location_desc">Inclure vos coordonnées GPS dans les chunks SOS pour que les sauveteurs vous trouvent sur le radar.</string>
    <string name="permission_notifications_desc">Maintenir le diffuseur SOS actif en arrière-plan et alerter les sauveteurs proches.</string>

    <!-- Status pill labels -->
    <string name="permission_status_pending">À faire</string>
    <string name="permission_status_granted">✓ Accordé</string>
    <string name="permission_status_denied">✗ Refusé</string>
    <string name="permission_status_settings">⚙ Réglages</string>

    <!-- Buttons -->
    <string name="permissions_btn_grant_all">Tout accorder</string>
    <string name="permissions_btn_continue">Continuer vers la démo</string>

    <!-- Summary template -->
    <string name="permissions_summary_template">%1$d / %2$d accordées</string>

    <!-- Privacy + Why -->
    <string name="permissions_privacy_note">JEMMA n\'envoie jamais vos données. Ces autorisations restent sur votre téléphone. Mode avion ou rien.</string>
    <string name="permissions_why_link">Pourquoi sont-elles toutes obligatoires ?</string>
    <string name="permissions_why_text">JemmaAppDemo est une vraie démo, pas une démo bidon. Chaque fonctionnalité montrée au jury doit fonctionner de bout en bout :\n\n• Le pipeline scan médicament a besoin de la caméra.\n• Le pipeline saisie vocale a besoin du microphone.\n• La diffusion SOS mesh a besoin des 3 permissions Bluetooth + GPS + de la notification du foreground service.\n\nSi l\'une de ces permissions est refusée, la démo correspondante échouerait au moment de l\'enregistrement vidéo. Le règlement du hackathon exige une soumission entièrement fonctionnelle.</string>

    <!-- Settings rationale (shown in dialog when DENIED_PERMANENT) -->
    <string name="permissions_rationale_title">Ouvrir les Réglages</string>
    <string name="permissions_rationale_message">Vous avez précédemment refusé cette permission. Merci de l\'accorder manuellement dans Réglages Android → Applications → JemmaAppDemo → Autorisations.</string>
    <string name="permissions_rationale_btn_open">Ouvrir les Réglages</string>
    <string name="permissions_rationale_btn_cancel">Annuler</string>


