<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_triage_btn.xml — circular icon button used 6 times per peer row in
    the radar list (WAIT/EVAL/STAB/HELP/EVAC/DCD). Subtle stroke for visual
    separation between adjacent buttons.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="oval">
    <solid android:color="@color/jemma_card_active" />
    <stroke android:width="1dp" android:color="@color/jemma_primary_25" />
</shape>
