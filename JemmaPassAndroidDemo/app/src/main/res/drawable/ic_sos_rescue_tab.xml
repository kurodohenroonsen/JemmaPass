<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_sos_rescue_tab.xml — bottom-nav icon for the "🚨 SOS/Rescue"
    tab. Stylized alert triangle with a central "!" — instantly
    readable as emergency at 24dp size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Outer alert triangle -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="1.0"
        android:pathData="M12,2 L22,20 L2,20 Z" />

    <!-- Inner triangle cutout (lighter shade of the same shape) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,5 L19.5,18.5 L4.5,18.5 Z" />

    <!-- Exclamation bar -->
    <path
        android:fillColor="#000000"
        android:pathData="M11,9 L13,9 L13,14 L11,14 Z" />

    <!-- Exclamation dot -->
    <path
        android:fillColor="#000000"
        android:pathData="M11,15.5 L13,15.5 L13,17 L11,17 Z" />
</vector>
