<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_warning_chip.xml — DDI / allergy warning band shown on a medication row
    when the cross-check finds an interaction. Subtle red tint with rounded
    corners so it draws the eye without dominating the card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="#33DC2626" />
    <corners android:radius="6dp" />
    <stroke android:width="1dp" android:color="@color/severity_high" />
</shape>
