<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_assistant_cta.xml — Lot 14.3 (PHASE 14)

    Background pour le CTA banner Assistant. Vert légèrement saturé qui
    matche jemma_primary (la couleur de marque JEMMA) avec un dégradé
    léger pour donner du relief sans être criard.

    Volontairement sans border pour rester sobre dans le contexte d'une
    page de form. Le contraste avec @color/jemma_bg vient juste du fill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="135"
        android:startColor="#1F3A5F"
        android:endColor="#1A4D55"
        android:type="linear" />

    <corners android:radius="14dp" />

    <stroke
        android:width="1dp"
        android:color="#2D6E78" />
</shape>
