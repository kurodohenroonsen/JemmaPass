<?xml version="1.0" encoding="utf-8"?>
<!--
    qr_import_reticle.xml — v2.3.0a

    Cadre de visée pour le scan QR. Carré transparent avec bordure verte
    (jemma_primary) — pas de complications, on aide juste l'utilisateur
    à savoir où viser. Pas d'overlay sombre autour pour l'instant ; le
    PreviewView reste fullscreen visible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="3dp"
        android:color="#34d399" />

    <corners android:radius="16dp" />

    <solid android:color="@android:color/transparent" />
</shape>
