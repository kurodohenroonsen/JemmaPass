<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_assistant_mode_row.xml — Lot 14.3 (PHASE 14)

    Selectable background pour les 4 modes du bottom sheet
    (📸/📷/🎤/📋). Ripple bleuté + corners arrondis + bord subtil.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33339AF0">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F1C2B" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#1F3A5F" />
        </shape>
    </item>
</ripple>
