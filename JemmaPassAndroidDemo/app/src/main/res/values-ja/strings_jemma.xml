    <!-- ═════ Permissions onboarding (Livraison_demo_permissions_1.2.0) ═════ -->

    <!-- Header -->
    <string name="permissions_title">必要な権限</string>
    <string name="permissions_intro">JemmaAppDemo は端末内で 100 % 動作します。そのために、いくつかの低レベルな Android 権限が必要です。各権限は、対応する機能のためだけに使われます。</string>
    <string name="permissions_mandatory_chip">デモには すべて 必須</string>

    <!-- Card titles -->
    <string name="permission_camera_title">カメラ</string>
    <string name="permission_microphone_title">マイク</string>
    <string name="permission_bluetooth_title">Bluetooth (3 権限)</string>
    <string name="permission_location_title">正確な位置情報</string>
    <string name="permission_notifications_title">通知</string>

    <!-- Card descriptions -->
    <string name="permission_camera_desc">薬の箱・ブリスター・処方箋をスキャンし、Gemma 4 マルチモーダルで成分を特定します。</string>
    <string name="permission_microphone_desc">アレルギー・服用薬・連絡先名を音声入力します。音声は Gemma 4 によって端末内で処理され、クラウドには送信されません。</string>
    <string name="permission_bluetooth_desc">大規模災害時に JEMMA メッシュ経由で SOS チャンクを発信・受信します。インターネット接続は不要です。</string>
    <string name="permission_location_desc">救助者がレーダーで貴方を見つけられるよう、SOS チャンクに GPS 座標を含めます。</string>
    <string name="permission_notifications_desc">バックグラウンドで SOS 発信を維持し、近くの救助者に通知します。</string>

    <!-- Status pill labels -->
    <string name="permission_status_pending">未許可</string>
    <string name="permission_status_granted">✓ 許可済</string>
    <string name="permission_status_denied">✗ 拒否</string>
    <string name="permission_status_settings">⚙ 設定</string>

    <!-- Buttons -->
    <string name="permissions_btn_grant_all">すべて許可</string>
    <string name="permissions_btn_continue">デモへ進む</string>

    <!-- Summary template -->
    <string name="permissions_summary_template">%1$d / %2$d 許可済</string>

    <!-- Privacy + Why -->
    <string name="permissions_privacy_note">JEMMA はあなたのデータを決してアップロードしません。これらの権限は端末内に留まります。機内モードか、何もしないか。</string>
    <string name="permissions_why_link">なぜすべて必須なのですか?</string>
    <string name="permissions_why_text">JemmaAppDemo は本物のデモです。偽のデモではありません。審査員に見せる各機能は、最初から最後まで本当に動く必要があります :\n\n• 薬スキャン パイプラインにはカメラが必要です。\n• 音声入力 パイプラインにはマイクが必要です。\n• メッシュ SOS 発信 には 3 つの Bluetooth 権限 + GPS + フォアグラウンド サービス通知が必要です。\n\nいずれかが拒否されると、対応するデモが録画中に失敗します。ハッカソン規約は、完全に機能する提出物を要求しています。</string>

    <!-- Settings rationale -->
    <string name="permissions_rationale_title">設定を開く</string>
    <string name="permissions_rationale_message">この権限を以前に拒否されています。Android 設定 → アプリ → JemmaAppDemo → 権限 から手動で許可してください。</string>
    <string name="permissions_rationale_btn_open">設定を開く</string>
    <string name="permissions_rationale_btn_cancel">キャンセル</string>


