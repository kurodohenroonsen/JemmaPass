<resources>

    <string name="pillar_chip_active">アクティブ · 編集機能近日</string>

    <!-- ═══ 柱 #1 · patient ═══ -->
    <string name="pillar_patient_title">患者</string>
    <string name="pillar_patient_ips_type">FHIR R4 · Patient</string>
    <string name="pillar_patient_desc">身元と人口統計：氏名、性別、生年月日、血液型、連絡先。すべての IPS 文書のアンカー。</string>

    <!-- ═══ 柱 #2 · contacts ═══ -->
    <string name="pillar_contacts_title">緊急連絡先</string>
    <string name="pillar_contacts_ips_type">FHIR R4 · Patient.contact</string>
    <string name="pillar_contacts_desc">緊急時に連絡する信頼できる人（近親者、配偶者、友人）。FHIR Patient.contact[] にマッピング。</string>

    <!-- ═══ 柱 #3 · allergies ═══ -->
    <string name="pillar_allergies_title">アレルギー</string>
    <string name="pillar_allergies_ips_type">FHIR R4 · AllergyIntolerance</string>
    <string name="pillar_allergies_desc">確認済みの食物・薬物・環境・生物製剤アレルギーと重症度・反応。救助者の有害な相互作用回避に重要。</string>

    <!-- ═══ 柱 #4 · medications ═══ -->
    <string name="pillar_medications_title">処方薬</string>
    <string name="pillar_medications_ips_type">FHIR R4 · MedicationStatement</string>
    <string name="pillar_medications_desc">現在の処方：物質（ATC/RxNorm）、用量、頻度、経路。SOS受信時にDDInter 2.0 KB が876K 相互作用をリアルタイムチェック。</string>

    <!-- ═══ 柱 #5 · conditions ═══ -->
    <string name="pillar_conditions_title">現在の病状</string>
    <string name="pillar_conditions_ips_type">FHIR R4 · Condition (clinical_status=active)</string>
    <string name="pillar_conditions_desc">慢性または現在進行中の疾患：糖尿病、高血圧、喘息、心房細動など。SNOMED CT と ICD-10 でコード化。</string>

    <!-- ═══ 柱 #6 · pastProblems ═══ -->
    <string name="pillar_past_problems_title">既往歴</string>
    <string name="pillar_past_problems_ips_type">FHIR R4 · Condition (clinical_status=resolved)</string>
    <string name="pillar_past_problems_desc">解消された病状と歴史的診断：過去の手術、治癒した感染症、治癒した怪我。累積的な健康状況の文脈に有用。</string>

    <!-- ═══ 柱 #7 · immunizations ═══ -->
    <string name="pillar_immunizations_title">予防接種</string>
    <string name="pillar_immunizations_ips_type">FHIR R4 · Immunization</string>
    <string name="pillar_immunizations_desc">ワクチン接種履歴：ワクチンコード（CVX/SNOMED）、日付、ロット番号、製造元。渡航医療と感染症対応に重要。</string>

    <!-- ═══ 柱 #8 · procedures ═══ -->
    <string name="pillar_procedures_title">手術・処置</string>
    <string name="pillar_procedures_ips_type">FHIR R4 · Procedure</string>
    <string name="pillar_procedures_desc">手術および医療処置：虫垂切除、人工膝関節、心臓カテーテル法。SNOMED CT、CPT、ICD-10-PCS でコード化。</string>

    <!-- ═══ 柱 #9 · devices ═══ -->
    <string name="pillar_devices_title">医療機器</string>
    <string name="pillar_devices_ips_type">FHIR R4 · DeviceUseStatement</string>
    <string name="pillar_devices_desc">アクティブな医療機器とインプラント：ペースメーカー、インスリンポンプ、人工内耳、義肢。MRI 安全性と緊急医療に重要。</string>

    <!-- ═══ 柱 #10 · functional ═══ -->
    <string name="pillar_functional_title">機能状態</string>
    <string name="pillar_functional_ips_type">FHIR R4 · ClinicalImpression / Observation</string>
    <string name="pillar_functional_desc">感覚、運動、認知の障害：失明、難聴、麻痺、認知症。救助者がコミュニケーションを適応させるのに役立つ。</string>

    <!-- ═══ 柱 #11 · pregnancy ═══ -->
    <string name="pillar_pregnancy_title">妊娠状態</string>
    <string name="pillar_pregnancy_ips_type">FHIR R4 · Observation (LOINC 82810-3)</string>
    <string name="pillar_pregnancy_desc">現在の妊娠状態：妊娠中／妊娠していない／不明、予定日付き。薬剤と画像診断の禁忌に重要。</string>

    <!-- ═══ 柱 #12 · results ═══ -->
    <string name="pillar_results_title">検査結果</string>
    <string name="pillar_results_ips_type">FHIR R4 · Observation (LOINC)</string>
    <string name="pillar_results_desc">最近の検査値：血球数、血糖、INR、電解質など。LOINC と UCUM 単位でコード化。傾向分析の基礎。</string>

    <!-- ═══ 柱 #13 · advanceDirectives ═══ -->
    <string name="pillar_advance_title">事前指示書</string>
    <string name="pillar_advance_ips_type">FHIR R4 · Consent</string>
    <string name="pillar_advance_desc">終末期の希望：CPR（はい／いいえ）、コンフォートケア、人工栄養、臓器提供。患者の自律性を機械可読形式で表現。</string>

    <!-- ═══ 柱 #14 · consents ═══ -->
    <string name="pillar_consents_title">同意書</string>
    <string name="pillar_consents_ips_type">FHIR R4 · Consent</string>
    <string name="pillar_consents_desc">アクティブな同意と認可：データ共有、研究参加、臓器提供登録。意図と有効期限を追跡。</string>

    <!-- ═══ 柱 #15 · goals ═══ -->
    <string name="pillar_goals_title">ケアの目標</string>
    <string name="pillar_goals_ips_type">FHIR R4 · Goal</string>
    <string name="pillar_goals_desc">アクティブな治療目標：血圧目標、減量、回復のマイルストーン。ケアチームが治療計画を整合させるのに使用。</string>

    <!-- ═══ 柱 #16 · encounters ═══ -->
    <string name="pillar_encounters_title">受診履歴</string>
    <string name="pillar_encounters_ips_type">FHIR R4 · Encounter</string>
    <string name="pillar_encounters_desc">最近の医療受診：入院、外来診察、救急受診。現状のタイムライン的文脈を提供。</string>

    <!-- ═══ 柱 #17 · occupational ═══ -->
    <string name="pillar_occupational_title">職業データ</string>
    <string name="pillar_occupational_ips_type">FHIR R4 · Observation (LOINC 74166-0)</string>
    <string name="pillar_occupational_desc">現在の雇用状況：雇用主、職位。労働衛生、曝露歴、リハビリ計画に関連。</string>

    <!-- ═══ 柱 #18 · providers ═══ -->
    <string name="pillar_providers_title">ケアチーム</string>
    <string name="pillar_providers_ips_type">FHIR R4 · CareTeam / Practitioner</string>
    <string name="pillar_providers_desc">担当医とケア提供者：かかりつけ医、専門医、病院。引き継ぎとケアの継続性のための連絡先。</string>

